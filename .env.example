# Copy to .env (local) or set in your host's environment (e.g. Vercel). Never commit real values.

# Postgres via a pooled connection (pgbouncer / Supabase pooler :6543). Used at runtime.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct (non-pooled) connection. Used by `prisma db push` / migrations.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Hex secret used to hash device MACs. Set once and never change it (changing it unlinks all history).
# Generate: openssl rand -hex 32
HMAC_SALT=

# Used when generating firmware config.h for a sensor.
SENSOR_WIFI_SSID=
SENSOR_WIFI_PASSWORD=
# Public origin of this deployment; defaults to the request origin.
PUBLIC_URL=
